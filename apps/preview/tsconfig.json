{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@dcloudio/types", "vite/client"],
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "vue": ["node_modules/vue"],
      "@wot-ui/ui": ["node_modules/@wot-ui/ui"],
      "@wot-ui/ui/*": ["node_modules/@wot-ui/ui/*"]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "../../packages/shadcn-uniapp/registry/**/*.vue"
  ]
}
