{
  "name": "shadcn-uniapp",
  "version": "0.1.4",
  "description": "Shadcn-inspired themes, a theme creator, and source-owned blocks for Wot UI and uni-app.",
  "type": "module",
  "license": "MIT",
  "author": "guygubaby",
  "homepage": "https://shadcn-uniapp.guygubaby.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guygubaby/shadcn-uniapp.git",
    "directory": "packages/shadcn-uniapp"
  },
  "bugs": {
    "url": "https://github.com/guygubaby/shadcn-uniapp/issues"
  },
  "keywords": [
    "uni-app",
    "wot-ui",
    "shadcn",
    "vue",
    "theme",
    "design-tokens",
    "blocks"
  ],
  "bin": {
    "shadcn-uniapp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    }
  },
  "files": [
    "dist",
    "registry",
    "README.md",
    "LICENSE",
    "LUCIDE-LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "vite": ">=5.0.0 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.44",
    "magic-string": "^0.30.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "vite": "5.2.8"
  }
}
